#include "../src/resource.h"
#include <windows.h>
#include <dwmapi.h>

// Icon resource ID
#define IDI_SSP_ICON 101

// Resource file
IDI_SSP_ICON ICON "icons/app.ico"

// Version info
1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "ScientificSymbolPanel"
            VALUE "FileDescription",  "Scientific Symbol Panel"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "SSP"
            VALUE "LegalCopyright",   "Open Source (MIT)"
            VALUE "OriginalFilename", "SSP.exe"
            VALUE "ProductName",      "Scientific Symbol Panel"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
